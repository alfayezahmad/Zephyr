# ==============================================================================
# Zephyr AWS Cyber-Physical Air Quality Digital Twin - Environment Config
# Bharat Builds Tour: Event 02 - Environmental Hacks (Track 01: Air)
# ==============================================================================

# --- AWS Cloud & Bedrock Intelligence ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- AWS Open-Source Emulation (LocalStack) ---
# Set to 'true' to run fully offline with LocalStack S3, DynamoDB, and SNS
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT_URL=http://localstack:4566

# --- AWS Storage & Alerts ---
DYNAMODB_TABLE_NAME=Zephyr_AuditLogs
S3_BUCKET_NAME=zephyr-telemetry-lake
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:Zephyr-GRAP-Alerts

# --- Edge IoT & MQTT Telemetry ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
MQTT_TOPIC_SUB=zephyr/commands/dispatch

# --- Optional Fallback LLM ---
GEMINI_API_KEY=optional_fallback_gemini_key_here
